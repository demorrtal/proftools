[Unit]
Description=Telegram Task Manager Bot
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# Укажите пользователя, под которым работает бот (например root или ubuntu):
User=root
WorkingDirectory=/opt/telegram_bot
Environment="PYTHONUNBUFFERED=1"
Environment="TZ=Europe/Moscow"
ExecStart=/opt/telegram_bot/venv/bin/python /opt/telegram_bot/run.py
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=mixed

[Install]
WantedBy=multi-user.target
