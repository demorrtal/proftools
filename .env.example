# Токен вашего Telegram-бота, полученный у @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID общего чата для задач "ВСЕ" (необязательно, можно привязать прямо в чате командой /set_group)
# GENERAL_CHAT_ID=-1001234567890

# ID темы форума для задач "ВСЕ" (необязательно, можно настроить командой /set_topic в нужной ветке)
# GENERAL_TOPIC_ID=12345

# Путь к файлу базы данных SQLite
DATABASE_PATH=bot_database.db

# Публичный HTTPS URL вашего Telegram Mini App (например https://yourdomain.com или https://xxxx.ngrok-free.app)
# Нужен для открытия веб-приложения внутри Telegram:
WEBAPP_URL=https://your-domain-or-tunnel.com

# Порт встроенного веб-сервера Mini App
WEBAPP_PORT=8000
WEBAPP_HOST=0.0.0.0
